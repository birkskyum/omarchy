#!/bin/bash

# omarchy:summary=Match against the device tree's top-level compatible strings (whole string, case-insensitive).
# omarchy:args=<compatibles...>

# For models that omarchy-hw-match cannot tell apart because they share a DMI
# name. Unprivileged tests fake the device tree with the fixture roots
# omarchy-hw-platform reads; root reads only the live one.
compatible=/proc/device-tree/compatible
if (( EUID != 0 )) && [[ -n ${OMARCHY_PROC_ROOT:-}${OMARCHY_SYS_ROOT:-}${OMARCHY_IMAGE_ROOT:-} ]]; then
  compatible=""
  if [[ -n ${OMARCHY_PROC_ROOT:-} ]]; then
    compatible=$OMARCHY_PROC_ROOT/device-tree/compatible
  elif [[ -n ${OMARCHY_SYS_ROOT:-} ]]; then
    compatible=$OMARCHY_SYS_ROOT/firmware/devicetree/base/compatible
  fi
fi

found=0
if [[ -r $compatible ]]; then
  mapfile -d '' -t entries <"$compatible"
  for wanted in "$@"; do
    for entry in "${entries[@]}"; do
      # Quoted so a string is compared as written, never as a pattern.
      if [[ ${entry,,} == "${wanted,,}" ]]; then
        found=1
      fi
    done
  done
fi

(( found ))
